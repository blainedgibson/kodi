<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">6</defaultcontrol>
    <animation effect="fade" time="250">WindowOpen</animation>
    <animation effect="fade" time="250">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window().Property(fanart)]</texture>
            <aspectratio>scale</aspectratio>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC000000">white.png</texture>
        </control>
        <control type="group">
            <left>260</left>
            <top>200</top>
            <width>1400</width>
            <height>680</height>
            <control type="image">
                <left>620</left>
                <top>0</top>
                <width>160</width>
                <height>52</height>
                <texture>icon.png</texture>
                <aspectratio>keep</aspectratio>
            </control>
            <control type="label">
                <left>0</left>
                <top>70</top>
                <width>1400</width>
                <height>50</height>
                <font>font35_title</font>
                <textcolor>FFEDC8FF</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(title)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>125</top>
                <width>1400</width>
                <height>35</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(subtitle)]</label>
                <visible>!String.IsEmpty(Window().Property(subtitle))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>220</top>
                <width>1400</width>
                <height>60</height>
                <font>font16</font>
                <textcolor>FFEDC8FF</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(status.main)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>285</top>
                <width>1400</width>
                <height>45</height>
                <font>font13</font>
                <textcolor>FFB0B0B0</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(status.sub)]</label>
                <visible>!String.IsEmpty(Window().Property(status.sub))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>340</top>
                <width>1400</width>
                <height>35</height>
                <font>font12</font>
                <textcolor>FFE0B0FF</textcolor>
                <align>center</align>
                <label>$INFO[Window().Property(status.attempt)]</label>
                <visible>!String.IsEmpty(Window().Property(status.attempt))</visible>
            </control>
            <control type="image">
                <left>650</left>
                <top>400</top>
                <width>100</width>
                <height>100</height>
                <texture>icon.png</texture>
                <aspectratio>keep</aspectratio>
                <visible>!String.IsEmpty(Window().Property(resolve.spinning))</visible>
                <animation effect="rotate" start="0" end="360" center="auto" time="1800" loop="true" condition="true">Conditional</animation>
            </control>
            <control type="button" id="6">
                <left>550</left>
                <top>530</top>
                <width>300</width>
                <height>50</height>
                <label>Cancel</label>
                <font>font13</font>
                <align>center</align>
                <onclick>SetProperty(resolve.action,cancel)</onclick>
                <texturefocus colordiffuse="FFFF4444" border="3">Buttons/pixel.png</texturefocus>
                <texturenofocus colordiffuse="40FFFFFF" border="3">Buttons/pixel.png</texturenofocus>
            </control>
        </control>
    </controls>
</window>
